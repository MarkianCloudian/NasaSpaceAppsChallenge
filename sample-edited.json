{
  "schema_version": "0.2.0",
  "notes": "All numeric values are PLACEHOLDERS unless 'value_status' says 'measured'. Numbers are bare numbers; units live in 'unit'.",
  "conventions": {
    "temperature_unit": "degC",
    "range_semantics": "target.min/target.max inclusive; null = open bound",
    "score_range": [
      0,
      1
    ],
    "comparison_modes": {
      "absolute": "Earth value compared directly with target range (e.g. slope, mineral class).",
      "normalized": "Earth value compared after scaling to Earth's own range (used when the planetary value is physically impossible on Earth, e.g. lunar 250 degC day/night swing).",
      "not_comparable": "Criterion kept in profile for completeness/report only; excluded from score (e.g. vacuum, gravity)."
    }
  },
  "categories": {
    "geology": "Geology, mineralogy, and surface materials",
    "terrain": "Terrain, elevation, slope, roughness, craters, and other topographic features",
