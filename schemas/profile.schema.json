{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Reference profile (draft or frozen)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "body",
    "purpose",
    "reference_site",
    "search_constraints",
    "criteria"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "body": {
      "enum": [
        "Mars",
        "Moon"
      ]
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "reference_site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "lat",
        "lon",
        "radius_km"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 360
        },
        "radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crs": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "search_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat_range": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "minItems": 2,
          "maxItems": 2
        },
        "max_landcover_fraction": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "min_barren_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "min_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category_overrides": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "geology",
          "terrain",
          "thermal",
          "resources",
          "atmosphere",
          "biology",
          "subsurface",
          "operations"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      },
      "minItems": 1
    },
    "removed_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "weights_method": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_at": {
      "type": "string",
      "format": "date"
    },
    "percentile_population": {
      "enum": [
        "eligible",
        "all_land",
        "ice_free_land"
      ],
      "default": "eligible",
      "description": "Reference population for normalized-criterion percentiles (research D-021)"
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "quantity",
        "statistic",
        "unit",
        "evaluation_scale",
        "comparison",
        "value_status",
        "sources",
        "justification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "category": {
          "enum": [
            "geology",
            "terrain",
            "thermal",
            "resources",
            "atmosphere",
            "biology",
            "subsurface",
            "operations"
          ]
        },
        "quantity": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "statistic": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "baseline_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "evaluation_scale": {
          "enum": [
            "grid",
            "refinement",
            "both"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "minProperties": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classes"
              ],
              "properties": {
                "classes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "percentile"
              ],
              "properties": {
                "percentile": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "high": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "percentile": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "veto": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rank_in_category": {
          "type": "integer",
          "minimum": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "comparison": {
          "enum": [
            "absolute",
            "normalized",
            "not_comparable"
          ]
        },
        "scoring_rule": {
          "enum": [
            "trapezoid",
            "gaussian",
            "boolean",
            "class_overlap",
            "percentile"
          ]
        },
        "value_status": {
          "enum": [
            "measured",
            "placeholder"
          ]
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_sigma": {
              "type": "number",
              "minimum": 0
            },
            "earth_sigma": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "valid_bands": {
          "type": "string"
        },
        "class_map": {
          "type": "string"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "earth"
          ],
          "properties": {
            "target": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string"
                  },
                  "citation": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "accessed": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "source_id"
                    ]
                  },
                  {
                    "required": [
                      "citation"
                    ]
                  }
                ]
              }
            },
            "earth": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "footprint_statistic": {
          "enum": [
            "mean",
            "median",
            "max",
            "min",
            "p90",
            "p10",
            "fraction_true"
          ],
          "description": "Statistic over the circular footprint of reference_site.radius_km (research D-017)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "comparison": {
                "const": "not_comparable"
              }
            }
          },
          "else": {
            "required": [
              "target",
              "scoring_rule",
              "footprint_statistic"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "comparison": {
                "const": "normalized"
              }
            }
          },
          "then": {
            "properties": {
              "scoring_rule": {
                "const": "percentile"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scoring_rule": {
                "const": "class_overlap"
              }
            },
            "required": [
              "scoring_rule"
            ]
          },
          "then": {
            "required": [
              "class_map",
              "valid_bands"
            ]
          }
        }
      ]
    }
  }
}
