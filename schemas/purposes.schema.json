{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "purposes.schema.json",
  "title": "Purposes and category ranks",
  "type": "object",
  "required": [
    "purposes"
  ],
  "additionalProperties": false,
  "properties": {
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose_id",
          "description",
          "weight_method"
        ],
        "properties": {
          "purpose_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "description": {
            "type": "string"
          },
          "weight_method": {
            "enum": [
              "roc",
              "direct"
            ]
          },
          "category_ranks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geology",
              "terrain",
              "thermal",
              "resources",
              "atmosphere",
              "biology",
              "subsurface",
              "operations"
            ],
            "properties": {
              "geology": {
                "type": "integer",
                "minimum": 1
              },
              "terrain": {
                "type": "integer",
                "minimum": 1
              },
              "thermal": {
                "type": "integer",
                "minimum": 1
              },
              "resources": {
                "type": "integer",
                "minimum": 1
              },
              "atmosphere": {
                "type": "integer",
                "minimum": 1
              },
              "biology": {
                "type": "integer",
                "minimum": 1
              },
              "subsurface": {
                "type": "integer",
                "minimum": 1
              },
              "operations": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "category_weights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geology",
              "terrain",
              "thermal",
              "resources",
              "atmosphere",
              "biology",
              "subsurface",
              "operations"
            ],
            "properties": {
              "geology": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "terrain": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "thermal": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "resources": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "atmosphere": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "biology": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "subsurface": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "operations": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "weight_method": {
                  "const": "roc"
                }
              }
            },
            "then": {
              "required": [
                "category_ranks"
              ]
            },
            "else": {
              "required": [
                "category_weights"
              ]
            }
          }
        ]
      }
    }
  }
}
