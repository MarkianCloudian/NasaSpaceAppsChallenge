{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layers.schema.json",
  "title": "Grid layer registry (research D-019)",
  "type": "object",
  "required": [
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "builder",
          "source_id",
          "params",
          "resampling",
          "outputs"
        ],
        "properties": {
          "layer_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "builder": {
            "enum": [
              "modis_cmg",
              "landcover_fractions",
              "climatology_rest",
              "dem_block_stats",
              "gridded_netcdf"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "params": {
            "type": "object",
            "description": "Builder-specific: variables, scale, offset, nodata, quality rule, temporal statistic, reference years, block size"
          },
          "resampling": {
            "enum": [
              "none",
              "bilinear",
              "area_mean",
              "block_stats",
              "majority"
            ]
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layer_id",
                "quantity",
                "unit",
                "statistic"
              ],
              "properties": {
                "layer_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "unit": {
                  "type": "string"
                },
                "statistic": {
                  "type": "string"
                },
                "baseline_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "notes": {
            "type": "string"
          },
          "fallback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "builder",
              "source_id",
              "params"
            ],
            "description": "Alternative build with the same outputs (research D-019)",
            "properties": {
              "builder": {
                "enum": [
                  "modis_cmg",
                  "landcover_fractions",
                  "climatology_rest",
                  "dem_block_stats",
                  "gridded_netcdf"
                ]
              },
              "source_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "params": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
