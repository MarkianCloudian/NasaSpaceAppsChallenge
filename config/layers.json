{
  "layers": [
    {
      "layer_id": "mcd12c1_landcover",
      "builder": "landcover_fractions",
      "source_id": "modis-mcd12c1",
      "params": {
        "sds": "Land_Cover_Type_1_Percent",
        "year": 2023,
        "class_groups": {
          "water": [
            0
          ],
          "forest": [
            1,
            2,
            3,
            4,
            5
          ],
          "grass_shrub": [
            6,
            7,
            8,
            9,
            10
          ],
          "wetland": [
            11
          ],
          "cropland": [
            12,
            14
          ],
          "urban": [
            13
          ],
          "snow_ice": [
            15
          ],
          "barren": [
            16
          ]
        },
        "land_rule": "water < 0.5"
      },
      "resampling": "none",
      "outputs": [
        {
          "layer_id": "land_mask",
          "quantity": "land_mask",
          "unit": "boolean",
          "statistic": "water fraction < 0.5"
        },
        {
          "layer_id": "lc_frac_water",
          "quantity": "lc_frac_water",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        },
        {
          "layer_id": "lc_frac_forest",
          "quantity": "lc_frac_forest",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        },
        {
          "layer_id": "lc_frac_grass_shrub",
          "quantity": "lc_frac_grass_shrub",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        },
        {
          "layer_id": "lc_frac_wetland",
          "quantity": "lc_frac_wetland",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        },
        {
          "layer_id": "lc_frac_cropland",
          "quantity": "lc_frac_cropland",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        },
        {
          "layer_id": "lc_frac_urban",
          "quantity": "lc_frac_urban",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        },
        {
          "layer_id": "lc_frac_snow_ice",
          "quantity": "lc_frac_snow_ice",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        },
        {
          "layer_id": "lc_frac_barren",
          "quantity": "lc_frac_barren",
          "unit": "fraction",
          "statistic": "class-group fraction (0-1)"
        }
      ],
      "notes": "year = latest of grid.reference_years in config/settings.json (T010: 2019-2023); keep in sync."
    },
    {
      "layer_id": "mod11c3_lst",
      "builder": "modis_cmg",
      "source_id": "modis-mod11c3",
      "params": {
        "variables": {
          "day": "LST_Day_CMG",
          "night": "LST_Night_CMG"
        },
        "scale": 0.02,
        "offset_c": -273.15,
        "qc": {
          "day": "QC_Day",
          "night": "QC_Night",
          "keep": "mandatory_qa_good_or_other_quality"
        },
        "reference_years": "settings:grid.reference_years",
        "temporal": "calendar_month_mean"
      },
      "resampling": "none",
      "outputs": [
        {
          "layer_id": "lst_day_max",
          "quantity": "land_surface_temp_day",
          "unit": "degC",
          "statistic": "max of monthly means"
        },
        {
          "layer_id": "lst_night_min",
          "quantity": "land_surface_temp_night",
          "unit": "degC",
          "statistic": "min of monthly means"
        },
        {
          "layer_id": "lst_mean",
          "quantity": "land_surface_temp",
          "unit": "degC",
          "statistic": "mean of monthly means"
        },
        {
          "layer_id": "lst_amp",
          "quantity": "lst_diurnal_amplitude",
          "unit": "degC",
          "statistic": "mean of monthly (day - night)"
        }
      ]
    },
    {
      "layer_id": "mod13c2_ndvi",
      "builder": "modis_cmg",
      "source_id": "modis-mod13c2",
      "params": {
        "variables": {
          "ndvi": "CMG 0.05 Deg Monthly NDVI"
        },
        "scale": 0.0001,
        "qc": {
          "ndvi": "CMG 0.05 Deg Monthly pixel reliability",
          "keep": "good_or_marginal"
        },
        "reference_years": "settings:grid.reference_years",
        "temporal": "calendar_month_mean",
        "temporal_reduce": "max"
      },
      "resampling": "none",
      "outputs": [
        {
          "layer_id": "ndvi_max",
          "quantity": "ndvi_max",
          "unit": "index",
          "statistic": "max of calendar-month climatology"
        }
      ],
      "notes": "NDVI = max over the 12 calendar-month climatology (generic temporal_reduce). SDS and QC names follow the MOD13C2 V061 CMG layout; QC SDS name and reliability codes still to be verified against the MOD13C2 user guide (verify)."
    },
    {
      "layer_id": "power_climate",
      "builder": "climatology_rest",
      "source_id": "nasa-power",
      "params": {
        "parameters": {
          "T2M": "t2m_mean",
          "T2M_MIN": "t2m_min",
          "T2M_MAX": "t2m_max",
          "RH2M": "rh2m_mean",
          "WS10M": "ws10m_mean",
          "PRECTOTCORR": "precip_annual",
          "ALLSKY_SFC_SW_DWN": "insolation_mean"
        },
        "unit_conversions": {
          "precip_annual": {
            "factor": 365.25,
            "from": "mm/day",
            "to": "mm/yr"
          }
        }
      },
      "resampling": "bilinear",
      "outputs": [
        {
          "layer_id": "t2m_mean",
          "quantity": "t2m_mean",
          "unit": "degC",
          "statistic": "annual mean"
        },
        {
          "layer_id": "t2m_min",
          "quantity": "t2m_min",
          "unit": "degC",
          "statistic": "annual minimum"
        },
        {
          "layer_id": "t2m_max",
          "quantity": "t2m_max",
          "unit": "degC",
          "statistic": "annual maximum"
        },
        {
          "layer_id": "rh2m_mean",
          "quantity": "rh2m_mean",
          "unit": "percent",
          "statistic": "annual mean"
        },
        {
          "layer_id": "ws10m_mean",
          "quantity": "ws10m_mean",
          "unit": "m/s",
          "statistic": "annual mean"
        },
        {
          "layer_id": "precip_annual",
          "quantity": "precip_annual",
          "unit": "mm/yr",
          "statistic": "annual total"
        },
        {
          "layer_id": "insolation_mean",
          "quantity": "insolation_mean",
          "unit": "kWh/m2/day",
          "statistic": "annual mean"
        }
      ],
      "fallback": {
        "builder": "gridded_netcdf",
        "source_id": "era5-cds",
        "params": {
          "variables": [
            "2m_temperature",
            "2m_dewpoint_temperature",
            "total_precipitation",
            "10m_u_component_of_wind",
            "10m_v_component_of_wind",
            "surface_solar_radiation_downwards"
          ],
          "derived": {
            "rh2m_mean": "magnus(t2m, d2m)",
            "ws10m_mean": "hypot(u10, v10)"
          },
          "reference_years": "settings:grid.reference_years"
        }
      }
    },
    {
      "layer_id": "etopo_terrain",
      "builder": "dem_block_stats",
      "source_id": "etopo-2022",
      "params": {
        "block": 6,
        "slope_method": "horn"
      },
      "resampling": "block_stats",
      "outputs": [
        {
          "layer_id": "elev_mean",
          "quantity": "elevation",
          "unit": "m",
          "statistic": "block mean"
        },
        {
          "layer_id": "relief",
          "quantity": "relief",
          "unit": "m",
          "statistic": "block max - min",
          "baseline_m": 926
        },
        {
          "layer_id": "slope_p90_1km",
          "quantity": "slope_p90",
          "unit": "deg",
          "statistic": "block p90 of native slope",
          "baseline_m": 926
        },
        {
          "layer_id": "elev_std",
          "quantity": "elevation_std",
          "unit": "m",
          "statistic": "block standard deviation"
        }
      ]
    }
  ]
}
